@model IEnumerable<RaceDay.MVC.Models.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder mb-0 border-start border-4 border-warning ps-3">My Events</h2>
            <p class="text-muted mt-1 ms-3">Manage your races and participants</p>
        </div>
        <a asp-action="Create" class="btn btn-success px-4 py-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Create New Event
        </a>
    </div>

       @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 bg-white text-center py-5">
            <div class="card-body">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-calendar-plus text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h4 class="fw-bold text-dark">No events created yet.</h4>
                <p class="text-muted mb-0">Click the yellow button above to host your first race.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Enrolments</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@ev.Name</td>
                                <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@ev.Location</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill">0 Enrolled</span>
                                </td>
                                <td>
                                    @if(ev.Status == "Open") { <span class="badge bg-success">Open</span> }
                                    else { <span class="badge bg-secondary">@ev.Status</span> }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Categories" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-primary fw-bold">Categories</a>
                                        <a asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-info fw-bold">Enrolments</a>
                                        <a asp-action="Edit" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-secondary fw-bold">Edit</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>