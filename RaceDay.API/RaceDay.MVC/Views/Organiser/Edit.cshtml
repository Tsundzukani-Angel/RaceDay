@model RaceDay.MVC.Models.EventViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark">
            <h3 class="mb-0 text-white">Edit Event: @Model.Name</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="EventID" />
                <input type="hidden" asp-for="BannerUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Event Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label fw-bold">Event Date</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RegistrationDeadline" class="form-label fw-bold">Registration Deadline</label>
                        <input asp-for="RegistrationDeadline" type="datetime-local" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="Location" class="form-label fw-bold">Location</label>
                        <input asp-for="Location" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Distance" class="form-label fw-bold">Distance (km)</label>
                        <input asp-for="Distance" type="number" step="0.1" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxParticipants" class="form-label fw-bold">Max Participants</label>
                    <input asp-for="MaxParticipants" type="number" class="form-control" />
                </div>

                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.BannerUrl))
                    {
                        <label class="form-label fw-bold d-block">Current Banner</label>
                        <img src="@Model.BannerUrl" alt="Current Banner" class="img-thumbnail mb-2" style="max-height: 150px;" />
                    }

                    <label asp-for="BannerFile" class="form-label fw-bold">Upload New Banner (Optional)</label>
                    <input asp-for="BannerFile" name="BannerFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="BannerFile" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Dashboard" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-warning px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
