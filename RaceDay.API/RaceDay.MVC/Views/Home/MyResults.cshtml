@model IEnumerable<RaceDay.MVC.Models.ResultDto>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">My Race Results</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You don't have any race results yet. Keep training!</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        <tr>
                            <td class="fw-bold">@res.EventName</td>
                            <td>@res.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@res.Category</td>
                            <td class="text-success fw-bold">@res.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td><span class="badge bg-primary">@res.Position</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
