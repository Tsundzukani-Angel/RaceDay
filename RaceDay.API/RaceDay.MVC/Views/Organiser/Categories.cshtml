@model IEnumerable<RaceDay.MVC.Models.CategoryDto>
@{
    ViewData["Title"] = $"Categories for {ViewBag.EventName}";
}

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Categories</h2>
            <p class="text-muted mb-0">Manage categories for <strong>@ViewBag.EventName</strong></p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="row">
        <!-- Add Category Form -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add New Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        <input type="hidden" name="EventID" value="@ViewBag.EventId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Name</label>
                            <input type="text" name="CategoryName" class="form-control" placeholder="e.g. Senior Male" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Type</label>
                            <select name="CategoryType" class="form-select">
                                <option value="Age">Age</option>
                                <option value="Distance">Distance</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Entry Fee (R)</label>
                            <input type="number" step="0.01" name="EntryFee" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Existing Categories List -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Existing Categories</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            No categories added yet.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Entry Fee</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@cat.CategoryName</td>
                                        <td><span class="badge bg-secondary">@cat.CategoryType</span></td>
                                        <td>R @cat.EntryFee.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
