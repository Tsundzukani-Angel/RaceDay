@model IEnumerable<RaceDay.MVC.Models.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<!-- Hero Section with Background Image -->
<div class="hero-section text-white d-flex align-items-center" style="background: linear-gradient(rgba(30, 60, 114, 0.8), rgba(42, 82, 152, 0.9)), url('https://images.unsplash.com/photo-1552674605-db6ffd4facb5?q=80&w=2070&auto=format&fit=crop') center/cover;">
    <div class="container text-center py-5 text-white">
        
        <h1 class="display-3 fw-bolder mb-3 text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">Find Your Next Challenge</h1>
        <p class="lead fs-4 mb-4">Join thousands of runners, walkers, and cyclists across South Africa.</p>
        @if (Context.Session.GetString("UserId") == null)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg fw-bold px-5 py-3 rounded-pill shadow">Register Now</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-lg fw-bold px-5 py-3 rounded-pill shadow">Browse Events</a>
        }
    </div>
</div>

<div class="container mt-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                <i class="bi bi-calendar-x text-primary" style="font-size: 3rem;"></i>
            </div>
            <h3 class="fw-bold text-dark">No events scheduled yet</h3>
            <p class="text-muted">Check back soon or ask an organiser to create one!</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h3 class="fw-bolder text-white mb-0 border-start border-4 border-warning ps-3">Upcoming Races</h3>
            <span class="text-muted fw-bold">@Model.Count() Events Found</span>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm card-hover rounded-3 overflow-hidden">
                        @if (!string.IsNullOrEmpty(ev.BannerUrl))
                        {
                            <img src="@ev.BannerUrl" class="card-img-top" alt="@ev.Name" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-dark text-white d-flex align-items-center justify-content-center" style="height: 220px; background-image: linear-gradient(45deg, #1e3c72, #2a5298);">
                                <i class="bi bi-trophy" style="font-size: 4rem; opacity: 0.5;"></i>
                            </div>
                        }

                        <div class="card-body p-4 position-relative">
                            <!-- Floating Badge -->
                            <span class="badge position-absolute top-0 start-50 translate-middle-x @(ev.EventType == "Run" ? "bg-success" : ev.EventType == "Cycle" ? "bg-info text-dark" : "bg-primary") shadow fs-6 px-3 py-2 mt-2">
                                @ev.EventType
                            </span>

                            <div class="text-center mt-3 mb-3">
                                <small class="text-muted fw-bold text-uppercase tracking-wider">@ev.EventDate.ToString("dd MMM yyyy")</small>
                                <h4 class="card-title fw-bolder mt-1 mb-0">@ev.Name</h4>
                            </div>

                            <div class="d-flex justify-content-between text-muted small mb-2 border-top border-bottom py-2">
                                <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> @ev.Location</span>
                                <span><i class="bi bi-signpost-2-fill text-primary me-1"></i> @ev.Distance km</span>
                            </div>

                            <p class="card-text text-muted small mb-0 text-center">@(ev.Description.Length > 60 ? ev.Description.Substring(0, 60) + "..." : ev.Description)</p>
                        </div>

                        <div class="card-footer bg-light border-0 d-flex justify-content-between align-items-center p-3">
                            <span class="fs-5 fw-bolder text-dark">R @(ev.Categories.Any() ? ev.Categories.Min(c => c.EntryFee).ToString("0.00") : "0.00")</span>
                            <a asp-action="EventDetails" asp-route-id="@ev.EventID" class="btn btn-primary fw-bold rounded-pill px-4">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>