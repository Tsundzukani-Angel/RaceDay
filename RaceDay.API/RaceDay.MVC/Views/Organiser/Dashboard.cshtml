@model IEnumerable<RaceDay.MVC.Models.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">My Events</h2>
        <a asp-controller="Organiser" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create New Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You haven't created any events yet. Click "Create New Event" to get started.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-light">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Enrolments</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="fw-bold">@ev.Name</td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td>
                                @* Note: For the dashboard, we need an enrolment count. 
                                   For now, we will just show 0, and add the real count later. *@
                                <span class="badge bg-info text-dark">0 Enrolled</span>
                            </td>
                            <td>
                                @if (ev.Status == "Open")
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">@ev.Status</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Categories" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-primary">Categories</a>
                                <a asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-info text-white">Enrolments</a>
                                <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>