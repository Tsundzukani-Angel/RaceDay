@model IEnumerable<RaceDay.MVC.Models.EnrolmentDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">My Enrolments</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't entered any events yet. <a asp-action="Index">Browse events</a>.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Race Number</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enr in Model)
                    {
                        <tr>
                            <td class="fw-bold">@enr.Event.Name</td>
                            <td>@enr.Event.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@enr.Category.CategoryName</td>
                            <td>
                                @if (enr.PaymentStatus == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(enr.RaceNumber) ? "-" : enr.RaceNumber)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
